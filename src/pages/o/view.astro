---
import Base from "../../layouts/Base.astro";
import { SECTIONS } from "../../../app/views.mjs";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title="Outage | Blast Radius" description="A breakdown built on demand from a company's own postmortem." toc={SECTIONS}>
  <article class="br-contents" data-replay data-base={base}>
    <p class="br-title"><b data-view-title>Loading the breakdown</b></p>
    <p class="br-lede br-muted" data-view-note>Fetching it from the archive.</p>
  </article>
</Base>

<script>
  import { outageBody } from "../../../app/views.mjs";
  import { bench } from "../../../app/bench.mjs";
  import { mountReplay } from "../../../app/replay.mjs";
  const root = document.querySelector<HTMLElement>("[data-replay]")!;
  const base = root.dataset.base ?? "";
  const id = new URLSearchParams(location.search).get("id") ?? "";
  const fail = (text: string) => {
    root.querySelector("[data-view-title]")!.textContent = "Not found";
    root.querySelector("[data-view-note]")!.textContent = text;
  };
  const response = id ? await fetch(`${base}/api/outage?id=${encodeURIComponent(id)}`).catch(() => null) : null;
  if (!response?.ok) {
    fail("This breakdown is not in the archive. It may not have been built yet.");
  } else {
    const spec = await response.json();
    document.title = `${spec.company} | ${spec.title} | Blast Radius`;
    root.innerHTML = outageBody(spec, bench(spec).svg);
    mountReplay(root, spec);
  }
</script>
